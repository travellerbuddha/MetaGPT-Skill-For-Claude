+_MODEL_VERSION = re.compile(r"claude-(?:opus|sonnet|haiku|fable|mythos)-(\d+)(?:-(\d{1,2}))?(?!\d)")
+
+
+def uses_adaptive_thinking(model: str) -> bool:
+    """Claude 4.6+ only accept adaptive thinking; `budget_tokens` returns HTTP 400 on 4.7+/5.x."""
+    m = _MODEL_VERSION.search(model or "")
+    if not m:
+        return False
+    major, minor = int(m.group(1)), int(m.group(2) or 0)
+    return major >= 5 or (major == 4 and minor >= 6)
+
 
